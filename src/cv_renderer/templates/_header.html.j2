<header>
  <h1>{{ meta.name }}</h1>
  <p class="headline">{{ meta.title }}</p>
  <p class="contact">
    {{- meta.location -}}
    {%- if meta.email %} | {{ meta.email }}{% endif %}
    {%- if meta.phone %} | {{ meta.phone }}{% endif %}
    {%- if meta.links.linkedin %} | {{ meta.links.linkedin }}{% endif %}
    {%- if meta.links.github %} | {{ meta.links.github }}{% endif %}
    {%- if meta.links.portfolio %} | {{ meta.links.portfolio }}{% endif %}
  </p>
</header>
