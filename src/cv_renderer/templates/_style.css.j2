:root {
  --accent: {{ accent_color }};
  --color-heading: {{ theme.heading_color or "#000" }};
  --color-title: {{ theme.title_color or "inherit" }};
  --color-muted: {{ theme.muted_color or "inherit" }};
  --size-headline: {{ font_sizes.headline or font_sizes.body }}pt;
  --size-entry: {{ font_sizes.entry or font_sizes.body }}pt;
  --size-name: {{ font_sizes.name }}pt;
  --size-section: {{ font_sizes.section }}pt;
  --size-body: {{ font_sizes.body }}pt;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: {{ font_family }};
  font-size: var(--size-body);
  line-height: 1.30;
  color: #000;
  max-width: 780px;
  margin: 0 auto;
  padding: 28px 36px;
}

/* ── Header (shared by the CV and the cover letter) ── */
/* Mixed case, tracking closed back up: capitals needed the extra 0.8px to keep
   their counters open, and carrying that tracking into mixed case only loosens
   the name. */
h1 {
  font-size: var(--size-name);
  font-weight: bold;
  line-height: 1.1;
  letter-spacing: -0.2px;
}
.headline {
  margin-top: 3px;
  font-size: var(--size-headline);
  color: var(--color-title);
  font-weight: {{ "bold" if theme.title_bold else "normal" }};
  font-style: {{ "italic" if theme.title_italic else "normal" }};
}
.contact {
  margin-top: 3px;
  color: var(--color-muted);
}
/* The links line sits under the location/email line as a second row of the same
   block, not as a new paragraph. */
.contact + .contact { margin-top: 1px; }
.contact a {
  color: var(--accent);
  text-decoration: underline;
}
/* `contact_links: false` prints the address instead of the label and drops the
   link colour and underline, so the contact line reads as one uninterrupted
   run. The anchor stays — it is what carries the https:// the printed text
   omits, and without it a PDF viewer resolves a bare `linkedin.com/...` as a
   relative path and opens a blank page. */
.contact .contact-link {
  color: inherit;
  text-decoration: none;
}

/* Centred, while every section below stays left-aligned: the header is the one
   block that is not a list of entries, so centring it reads as a title page
   rather than as a broken column. */
header {
  margin-bottom: 9px;
  text-align: center;
}

/* ── Print ── */
@media print {
  body { padding: 0; max-width: 100%; }
  @page { size: A4; margin: 10mm 12mm 10mm 12mm; }
  a { color: var(--accent); text-decoration: underline; }
}
