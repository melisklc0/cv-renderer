<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <title>{{ meta.name }} — CV</title>
  <style>
    {% include "_style.css.j2" %}

    /* ── Sections ── */
    section { margin-bottom: 13px; }

    h2 {
      font-size: var(--size-section);
      font-weight: {{ "bold" if theme.heading_bold else "normal" }};
      color: var(--color-heading);
      border-bottom: 1px solid var(--color-heading);
      padding-bottom: 1px;
      margin-bottom: 5px;
      /* Never let a section heading sit alone at the foot of a page. */
      break-after: avoid;
      page-break-after: avoid;
    }

    /* ── About ── */
    .about-text { text-align: justify; }

    /* Entry headings carry their own size so a job title can outrank body text
       without dragging the date column up with it. */
    .entry-title { font-size: var(--size-entry); }

    /* ── Shared layout ── */
    .row-spaced {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
    }
    .dates {
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ── Experience ── */
    .job { margin-bottom: 10px; page-break-inside: avoid; }
    .job-desc {
      margin: 3px 0 3px;
      text-align: justify;
    }
    /* One notch above body text, so a sub-project heading below it reads as the
       second level rather than as a sibling of the employer line. */
    .job-heading {
      font-size: calc(var(--size-body) + 1pt);
      break-after: avoid;
      page-break-after: avoid;
    }

    /* ── Sub-projects (named workstreams inside one job) ── */
    .subproject {
      margin: 4px 0 0 10px;
      page-break-inside: avoid;
    }
    .subproject ul.bullets {
      padding-left: 12px;
      margin-top: 2px;
    }

    /* ── Bullets ── */
    ul.bullets {
      list-style: none;
      padding-left: 20px;
      margin-top: 4px;
    }
    /* Hanging indent, not positioning. `position: relative` made every bullet a
       positioned box, and CSS paints those after the whole normal flow — so the
       PDF text layer carried each bullet list behind the sections that visually
       followed it, and the absolute "-" landed after its own bullet's text.
       That layer is what an ATS parses and what a copy-paste picks up. */
    ul.bullets li {
      padding-left: 12px;
      text-indent: -12px;
      margin-bottom: 4px;
      line-height: 1.25;
      text-align: justify;
    }
    ul.bullets li::before {
      content: "-";
      display: inline-block;
      width: 12px;
      /* text-indent inherits; without this the marker gets pulled left too. */
      text-indent: 0;
    }

    /* ── Education ── */
    .edu-row {
      margin-bottom: 3px;
      page-break-inside: avoid;
      line-height: 1.15;
    }

    /* ── Skills ── */
    .skills-grid {
      display: grid;
      grid-template-columns: max-content 1fr;
      /* Narrow, because .skill-cat::after contributes the rest as a real space. */
      column-gap: 4px;
      row-gap: 2px;
      line-height: 1.15;
    }
    .skill-cat { color: var(--color-title); }
    /* The grid gap is physical space, not a character: where a long category
       fills its column the text layer extracts "Reporting:Apache Superset" as
       one token. A real space keeps the two sides separate for a parser. */
    .skill-cat::after, .cert-label::after { content: "\00a0"; }

    /* ── Projects ── */
    .project { margin-bottom: 10px; page-break-inside: avoid; }

    /* ── Additional ── */
    .additional-item { margin-bottom: 3px; }
    /* No gap: .cert-label::after carries the separator, so this row spaces the
       same way the Languages line above it does. */
    .cert-row { display: flex; align-items: flex-start; }
    .cert-label { white-space: nowrap; flex-shrink: 0; }
  </style>
</head>
<body>

{% include "_header.html.j2" %}

{% if about %}
<section>
  <h2>{{ labels.about }}</h2>
  <p class="about-text">{{ about | trim }}</p>
</section>
{% endif %}

{% for section in sections %}

{% if section == "experience" and experience %}
<section>
  <h2>{{ labels.experience }}</h2>
  {% for job in experience %}
  <div class="job">
    <div class="row-spaced job-heading">
      <strong class="entry-title">{{ job.title }}, {{ job.company }}, {{ job.location }}</strong>
      <span class="dates">{{ job.start | fmtdate }} {{ labels.to }} {{ job.end | fmtdate }}</span>
    </div>
    {% if job.description %}<p class="job-desc">{{ job.description }}</p>{% endif %}
    {% if job.projects %}
      {% for sub in job.projects %}
      <div class="subproject">
        <div class="row-spaced">
          <strong class="entry-title">{{ sub.name }}{% if sub.subtitle %} — {{ sub.subtitle }}{% endif %}</strong>
          <span class="dates">
            {%- if sub.year %}{{ sub.year }}
            {%- elif sub.start %}{{ sub.start | fmtdate }} {{ labels.to }} {{ sub.end | fmtdate }}
            {%- endif %}
          </span>
        </div>
        <ul class="bullets">
          {% for b in sub.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
      </div>
      {% endfor %}
    {% else %}
    <ul class="bullets">
      {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if section == "education" and education %}
<section>
  <h2>{{ labels.education }}</h2>
  {% for e in education %}
  <div class="row-spaced edu-row">
    <span><strong class="entry-title">{{ e.institution }}</strong>, {{ e.degree }}{% if e.location %}, {{ e.location }}{% endif %}</span>
    <span class="dates">{{ e.start | fmtdate }} {{ labels.to }} {{ e.end | fmtdate }}</span>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if section == "skills" and skills %}
<section>
  <h2>{{ labels.skills }}</h2>
  <div class="skills-grid">
    {% for cat in skills %}
    <strong class="skill-cat">{{ cat.category }}:</strong>
    <span>{{ cat.entries | join(", ") }}</span>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if section == "projects" and projects %}
<section>
  <h2>{{ labels.projects }}</h2>
  {% for proj in projects %}
  <div class="project">
    <div class="row-spaced">
      <strong class="entry-title">{{ proj.name }}{% if proj.subtitle %}, {{ proj.subtitle }}{% endif %}</strong>
      <span class="dates">
        {%- if proj.year %}{{ proj.year }}
        {%- elif proj.start %}{{ proj.start | fmtdate }} {{ labels.to }} {{ proj.end | fmtdate }}
        {%- endif %}
      </span>
    </div>
    <ul class="bullets">
      {% for b in proj.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if section == "additional" and additional %}
<section>
  <h2>{{ labels.additional }}</h2>
  {% if additional.languages %}
  <p class="additional-item">
    <strong>{{ labels.languages }}:</strong> {{ additional.languages | join(", ") }}
  </p>
  {% endif %}
  {% if additional.certifications %}
  <div class="additional-item cert-row">
    <strong class="cert-label">{{ labels.certifications }}:</strong>
    <span>{% for cert in additional.certifications %}{{ cert }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>
  </div>
  {% endif %}
</section>
{% endif %}

{% endfor %}

</body>
</html>
