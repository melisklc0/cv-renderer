# Path to your CV data directory.
# Default: user-data/ inside the repo (created by `uv run python render.py init`)
# Override if your data lives outside the repo:
# CV_DATA_DIR=/absolute/path/to/your/cv-data
CV_DATA_DIR=

# Path to write rendered HTML/PDF output.
# Default: out/ inside the repo
# CV_OUT_DIR=/absolute/path/to/your/output
CV_OUT_DIR=
